[Unit]
Description=EM Server Sense HAT MQTT Publisher
After=network.target mosquitto.service
Wants=mosquitto.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/EM_server
ExecStart=/home/pi/EM_server/venv/bin/python -m em_server.services.sensehat_service --config config.json
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
